---
import StatusBadge from './StatusBadge.astro';
import type { Eatery } from '../data/trip';

interface Props {
  eatery: Eatery;
}

const { eatery } = Astro.props;
---

<article class="card card-pad eatery">
  <div class="split-title">
    <div class="name-block">
      <h3>{eatery.name}</h3>
      {eatery.reading && <span class="reading">{eatery.reading}</span>}
    </div>
    <StatusBadge status={eatery.status} />
  </div>

  <div class="chips">
    <span class="chip chip-genre">{eatery.genre}</span>
    <span class="chip">{eatery.area}</span>
  </div>

  <p class="hook">{eatery.hook}</p>

  <ul class="menu">
    {
      eatery.dishes.map((dish) => (
        <li>
          <span class="dish">{dish.name}</span>
          <span class="dots" aria-hidden="true" />
          <span class="price">{dish.price}</span>
        </li>
      ))
    }
  </ul>

  <dl class="hours">
    <div><dt>営業</dt><dd>{eatery.hours}</dd></div>
    <div><dt>定休</dt><dd>{eatery.closed}</dd></div>
    <div class="sw"><dt>9/20</dt><dd>{eatery.sunday}</dd></div>
    <div><dt>TEL</dt><dd><a href={`tel:${eatery.tel}`}>{eatery.tel}</a></dd></div>
  </dl>

  {
    eatery.memo.length > 0 && (
      <ul class="list memo">
        {eatery.memo.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )
  }

  <div class="links">
    <a class="text-link" href={eatery.mapUrl} target="_blank" rel="noreferrer">地図を見る</a>
    <a class="text-link" href={eatery.linkUrl} target="_blank" rel="noreferrer">{eatery.linkLabel}</a>
  </div>
</article>

<style>
  .eatery {
    display: flex;
    flex-direction: column;
    align-self: start;
  }

  .name-block {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .eatery h3 {
    font-size: 1.1rem;
  }

  .reading {
    font-size: 0.75rem;
    color: var(--color-muted);
    letter-spacing: 0.04em;
  }

  .chips {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: 0.6rem;
  }

  .chip {
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    color: var(--color-muted);
  }

  .chip-genre {
    background: var(--color-teal);
    border-color: var(--color-teal);
    color: #fff;
  }

  .hook {
    margin-top: 0.85rem;
    font-size: 0.92rem;
    line-height: 1.75;
  }

  .menu {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0.85rem 0.9rem;
    background: rgba(31, 95, 91, 0.05);
    border-radius: 12px;
  }

  .menu li {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    font-size: 0.88rem;
  }

  .menu li + li {
    margin-top: 0.45rem;
  }

  .dish {
    font-weight: 700;
  }

  .dots {
    flex: 1;
    border-bottom: 1px dotted var(--color-line);
    transform: translateY(-0.25em);
  }

  .price {
    font-weight: 800;
    color: var(--color-teal);
    white-space: nowrap;
  }

  .hours {
    margin: 1rem 0 0;
    font-size: 0.84rem;
  }

  .hours div {
    display: flex;
    gap: 0.6rem;
    padding: 0.3rem 0;
    border-top: 1px solid var(--color-line);
  }

  .hours dt {
    flex: 0 0 3.2rem;
    font-weight: 800;
    color: var(--color-muted);
  }

  .hours dd {
    margin: 0;
  }

  .hours .sw dd {
    font-weight: 800;
    color: var(--color-accent);
  }

  .memo {
    margin-top: 0.9rem;
    font-size: 0.82rem;
    color: var(--color-muted);
  }

  .links {
    display: flex;
    gap: 1.1rem;
    margin-top: auto;
    padding-top: 1rem;
  }

  .text-link {
    color: var(--color-teal);
    font-weight: 800;
    font-size: 0.88rem;
  }
</style>
