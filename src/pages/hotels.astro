---
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import HotelCard from '../components/HotelCard.astro';
import { hotels, wishlistHotels } from '../data/trip';
---

<Layout title="Hotels">
  <header class="page-header">
    <h1>Hotels</h1>
    <p>龍泉洞泊＋八戸ベースの今回の旅で実際に泊まる宿です。全3泊とも予約済みです。</p>
  </header>

  <div class="notice">
    <strong>全泊予約済み</strong>
    9/20・9/22＝ホテルアドレ（朝食込）、9/21＝ホテル龍泉洞愛山（2食付）。いずれも予約確定です。
  </div>

  <SectionTitle title="泊まる宿（全泊予約済み）" />
  <section class="grid two">
    {hotels.map((hotel) => <HotelCard hotel={hotel} />)}
  </section>

  <SectionTitle title="来年行きたい宿" description="今年は見送り。次の機会に。" />
  <section class="grid two">{wishlistHotels.map((hotel) => <HotelCard hotel={hotel} />)}</section>
</Layout>
